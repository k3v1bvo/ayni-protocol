# =============================================================================
# AYNI PROTOCOL - ENVIRONMENT CONFIGURATION
# =============================================================================

# Supabase Project Credentials (Obtener en https://supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-de-supabase

# Application Base URL (para redirects de Google OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Redes Blockchain (Avalanche C-Chain Mainnet, HSK Testnet, Base L2)
NEXT_PUBLIC_AVALANCHE_ESCROW_ADDRESS=0x7A9fe51c8688281Ed66e0A98401B46a277c86D80
NEXT_PUBLIC_AVALANCHE_USDC_ADDRESS=0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E
NEXT_PUBLIC_AVALANCHE_CHAIN_ID=43114
NEXT_PUBLIC_HSK_ESCROW_ADDRESS=0x872660b3324236c306b539f90a02f8b8D019E9Ea
NEXT_PUBLIC_CHAIN_ID=84532 # Base Sepolia Testnet (o 8453 para Base Mainnet)
NEXT_PUBLIC_USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_AYNI_ESCROW_ADDRESS=0x71C93475A6E46949Cbc4928Eb811b7d566bEB49a

# Pollar (Stellar) — Wallet social + pagos USDC (obtener en https://dashboard.pollar.xyz)
NEXT_PUBLIC_POLLAR_API_KEY=pub_testnet_tu-clave-publicable
NEXT_PUBLIC_POLLAR_NETWORK=testnet # 'testnet' o 'mainnet'
NEXT_PUBLIC_POLLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
NEXT_PUBLIC_POLLAR_TREASURY_ADDRESS=tu-wallet-de-financiamiento-del-dashboard-de-pollar

# Unlock Protocol — Lock de membresia (crear en https://app.unlock-protocol.com, red Base Sepolia)
NEXT_PUBLIC_UNLOCK_LOCK_ADDRESS=

# =============================================================================
# DEPLOY DE CONTRATOS — HSK Chain + Avalanche (solo para desplegar, NUNCA subir con valores reales)
# =============================================================================
# Clave privada de la wallet que paga el gas del deploy (usa una wallet "quemada", nunca la principal)
DEPLOYER_PRIVATE_KEY=

# Direcciones opcionales del contrato AyniEscrow (por defecto usan la del deployer)
TOKEN_ADDRESS=
TREASURY_ADDRESS=
RESERVE_ADDRESS=
AI_ORACLE_ADDRESS=
# Nota: no hace falta API key de Snowtrace — Avalanche verifica via Routescan sin cuenta

# =============================================================================
# VARIABLES SECRETAS DE BACKEND (SOLO SERVIDOR - NUNCA SE EXPONEN AL CLIENTE)
# =============================================================================
# Supabase Service Role Key (Admin / Server-only)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-de-supabase

# Google AI Studio - Gemini 1.5 Flash (https://aistudio.google.com/)
GEMINI_API_KEY=tu-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# ImgBB Image Hosting API (https://api.imgbb.com/)
IMGBB_API_KEY=tu-imgbb-api-key

# Google Gmail SMTP Mailer (Contraseña de aplicación de 16 caracteres en myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ayniprotocol@gmail.com
SMTP_PASS=tu-clave-de-aplicacion-gmail
SMTP_PASSWORD=tu-clave-de-aplicacion-gmail
SMTP_FROM="AYNI Protocol" <ayniprotocol@gmail.com>
